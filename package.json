{
  "name": "bayaan",
  "main": "entry.ts",
  "version": "2.3.0",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "postinstall": "patch-package && node scripts/bootstrap-android-local-properties.js",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --watchAll=false --ci --reporters=default",
    "test:widget-fixtures": "bash scripts/check-widget-fixtures.sh && bash scripts/check-widget-system-surfaces.sh && bash scripts/check-widget-content.sh",
    "generate:widget-data": "tsx scripts/generate-widget-data.ts",
    "generate:widget-vectors": "swift scripts/generate-hijri-table.swift > modules/bayaan-widgets/src/__fixtures__/hijri.table.json && tsx scripts/generate-context-vectors.ts",
    "check:rewayah-manifest": "node scripts/rewayah/gen-manifest.mjs --check",
    "eas-build-pre-install": "node scripts/rewayah/gen-manifest.mjs --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "i18n:check": "i18next-cli extract --ci --dry-run && i18next-cli lint",
    "i18n:status": "i18next-cli status",
    "i18n:unused": "i18next-cli status --unused",
    "apply:timestamps-coverage": "tsx scripts/apply-timestamps-coverage.ts",
    "mirror:timestamps": "tsx scripts/mirror-timestamps-to-r2.ts",
    "strip:broken-qdc": "tsx scripts/strip-broken-qdc-ids.ts",
    "add:new-reciters": "tsx scripts/add-new-reciters.ts",
    "format": "prettier --write .",
    "generate-reciter-images": "tsx scripts/generateReciterImages.ts",
    "generate-icons": "node scripts/generate-icons.js",
    "fetch-reciters": "tsx scripts/fetchReciterData.ts",
    "verify-catalog-urls": "tsx scripts/verify-catalog-urls.ts",
    "resize-splash-images": "node scripts/resize-splash-images.js",
    "sync:widget-fonts": "node scripts/sync-widget-fonts.js",
    "prebuild": "node scripts/sync-widget-fonts.js && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo prebuild --clean",
    "version:patch": "node scripts/version-bump.js patch",
    "version:minor": "node scripts/version-bump.js minor",
    "version:major": "node scripts/version-bump.js major",
    "version:current": "node scripts/generate-version.js",
    "ios:archive": "node scripts/rewayah/gen-manifest.mjs --check && ./scripts/ios-archive.sh",
    "ios:archive:upload": "node scripts/rewayah/gen-manifest.mjs --check && ./scripts/ios-archive.sh --upload",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "build:prod:ios": "eas build --profile production --platform ios"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/test-utils/setupI18n.ts"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.20.6",
    "@expo/server": "^0.1.0",
    "@expo/vector-icons": "^15.0.3",
