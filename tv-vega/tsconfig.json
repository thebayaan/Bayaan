{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["@amazon-devices/react-native-kepler"],
    // Prefer Vega files, mirroring Metro's platform resolution.
    "moduleSuffixes": [".kepler", ""],
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "react-native": ["node_modules/@amazon-devices/react-native-kepler"],
      "@react-native-async-storage/async-storage": [
        "node_modules/@amazon-devices/react-native-async-storage__async-storage"
      ],
      "@shopify/flash-list": [
        "node_modules/@amazon-devices/shopify__flash-list"
      ],
      "react-native-svg": ["node_modules/@amazon-devices/react-native-svg"],
      "expo-image": ["shims/expo-image.tsx"],
      "react": ["node_modules/@types/react"],
      "@/*": ["../*"],
      "*": ["node_modules/*", "node_modules/@types/*"]
    }
  },
  "include": [
    "env.d.ts",
    "../tv-app/App.tsx",
    "../tv-app/**/*.kepler.ts",
    "../tv-app/**/*.kepler.tsx"
  ],
  "exclude": ["../tv-app/node_modules"]
}
