+package expo.modules.audio.service
+
+import android.os.Handler
+import android.os.Looper
+import androidx.media3.common.FlagSet
+import androidx.media3.common.ForwardingPlayer
+import androidx.media3.common.Player
+import androidx.media3.common.util.UnstableApi
+import expo.modules.audio.AudioLockScreenTrackControls
+import java.util.IdentityHashMap
+
+// Bayaan patch: next/previous track commands for a player that opted in through
+// AudioLockScreenOptions.trackControls. Each command is reported as available
+// (so the system shows it) only while enabled, and never moves the underlying
+// player: it calls onCommand, and JS decides what next and previous mean.
+@UnstableApi
+internal class TrackControlsPlayer(
+  player: Player,
+  private var controls: AudioLockScreenTrackControls?,
+  private val onCommand: (String) -> Unit
+) : ForwardingPlayer(player) {
+  private val handler = Handler(applicationLooper)
+  private val listeners = IdentityHashMap<Player.Listener, Player.Listener>()
+
+  override fun addListener(listener: Player.Listener) {
+    val forwardingListener = synchronized(listeners) {
+      listeners.getOrPut(listener) { CommandsForwardingListener(listener) }
+    }
+    super.addListener(forwardingListener)
+  }
+
+  override fun removeListener(listener: Player.Listener) {
+    val forwardingListener = synchronized(listeners) {
+      listeners.remove(listener)
+    }
+    super.removeListener(forwardingListener ?: listener)
+  }
+
+  override fun getAvailableCommands(): Player.Commands {
+    val builder = super.getAvailableCommands().buildUpon()
+      .removeAll(
+        Player.COMMAND_SEEK_TO_NEXT,
+        Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM,
+        Player.COMMAND_SEEK_TO_PREVIOUS,
+        Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM
+      )
+    if (controls?.next == true) {
+      builder.addAll(Player.COMMAND_SEEK_TO_NEXT, Player.COMMAND_SEEK_TO_NEXT_MEDIA_ITEM)
+    }
+    if (controls?.previous == true) {
+      builder.addAll(Player.COMMAND_SEEK_TO_PREVIOUS, Player.COMMAND_SEEK_TO_PREVIOUS_MEDIA_ITEM)
+    }
+    return builder.build()
+  }
+
+  override fun isCommandAvailable(command: Int): Boolean = availableCommands.contains(command)
+
+  override fun seekToNext() = onCommand("next")
+
+  override fun seekToNextMediaItem() = onCommand("next")
+
+  override fun seekToPrevious() = onCommand("previous")
+
+  override fun seekToPreviousMediaItem() = onCommand("previous")
+
+  fun updateControls(controls: AudioLockScreenTrackControls?) {
+    if (Looper.myLooper() != applicationLooper) {
+      handler.post { updateControls(controls) }
+      return
+    }
+    this.controls = controls
+    val commands = availableCommands
+    val events = Player.Events(
+      FlagSet.Builder()
+        .add(Player.EVENT_AVAILABLE_COMMANDS_CHANGED)
+        .build()
+    )
+    val currentListeners = synchronized(listeners) {
+      listeners.keys.toList()
+    }
+    currentListeners.forEach {
+      it.onAvailableCommandsChanged(commands)
+    }
+    currentListeners.forEach {
+      it.onEvents(this, events)
+    }
+  }
+
+  // The wrapped player reports its own commands; listeners get ours.
+  private inner class CommandsForwardingListener(
+    private val listener: Player.Listener
+  ) : Player.Listener by listener {
+    override fun onAvailableCommandsChanged(availableCommands: Player.Commands) {
+      listener.onAvailableCommandsChanged(this@TrackControlsPlayer.availableCommands)
+    }
+
+    override fun onEvents(player: Player, events: Player.Events) {
+      listener.onEvents(this@TrackControlsPlayer, events)
+    }
+  }
+}
