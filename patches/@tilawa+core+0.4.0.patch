+// Bayaan patch. Junction check: did the reader say an ayah's last word?
+//
+// While the cursor is on an ayah's last two words, and until one chunk after it
+// enters the next ayah, find the best CTC fit of two hypotheses in the audio decoded
+// so far, from a little before the word before the last word:
+//
+//   word before + last word + next word's first sounds     (h1)
+//   word before + next word's first sounds                 (h0)
+//
+// Each may start and stop at any frame: audio outside the fit costs nothing. The
+// difference per token of the last word is llr. The last word is unsaid when:
+//
+// - early: h0 fits (fitNext or better) and llr is under llrMissing. The tracker has
+//   not crossed yet: it bends the next word's sounds onto the missing word for a
+//   second or two. While the last word is being said h0 does not fit, since the next
+//   word's sounds are not there. Off when the two words open alike.
+// - late: the cursor is one chunk into the next ayah, or past its first word, the last
+//   word's verdict is settled and not 'ok', llr is under llrMissing and h0 fits at
+//   least loosely (fitLate): a reader who went back to an earlier word is in neither
+//   hypothesis.
+//
+// It reads the frames the session already keeps in correction mode, the spans
+// verdicts() just computed and the engine's own tokenizer; no other model runs. The
+// hypotheses exist only inside this computation and are never shown. The numbers in
+// `JunctionOptions` were tuned on this model's output, so the caller passes them from
+// its NPL-1.2 constants file.
+import { encodePhonemes } from "./posteriors.js";
+import { BLANK_ID } from "./tokens.js";
+import { pausalPhonemes } from "./verdicts.js";
+const MADD = /(ۦ{3,}|ۥ{3,}|ا{3,})/gu;
+/** An ayah-end long madd read at two counts, as many reciters do. */
+function shortMadd(ph) {
+    return ph.replace(MADD, (m) => m.slice(0, 2));
+}
+/**
+ * Best fit of `ids` anywhere in frames [from, to): the path may start and stop at
+ * any frame, and frames outside it cost nothing. Against the free decode: <= 0,
+ * about 0 when the hypothesis is there. The tracker's idea of where the word before
+ * starts can be late when two nearby words sound alike, so the start is not forced
+ * on it.
+ */
+function forcedLocal(post, ids, from, to) {
+    const L = ids.length;
+    const S = 2 * L + 1;
+    if (to <= from)
+        return L === 0 ? 0 : -Infinity;
+    const ext = new Int32Array(S);
+    for (let s = 0; s < S; s++)
+        ext[s] = s % 2 === 1 ? ids[(s - 1) >> 1] : BLANK_ID;
+    let prev = new Float64Array(S).fill(-Infinity);
+    let next = new Float64Array(S);
+    let best = -Infinity;
+    for (let t = from; t < to; t++) {
+        const top = post.bestLogp(t);
+        for (let s = 0; s < S; s++) {
+            let m = prev[s];
+            if (s >= 1 && prev[s - 1] > m)
+                m = prev[s - 1];
+            if (s >= 2 && ext[s] !== BLANK_ID && ext[s] !== ext[s - 2] && prev[s - 2] > m)
+                m = prev[s - 2];
+            // A path may start here, on the first blank or the first token.
+            if (s <= 1 && m < 0)
+                m = 0;
+            next[s] = m === -Infinity ? -Infinity : m + post.logp(t, ext[s]) - top;
+        }
+        [prev, next] = [next, prev];
+        const v = L === 0 ? prev[0] : Math.max(prev[S - 1], prev[S - 2]);
+        if (v > best)
+            best = v;
+    }
+    return best;
+}
+/** Readings that tokenize alike need only one alignment. */
+function distinct(list) {
+    return [...new Map(list.map((ids) => [ids.join(","), ids])).values()];
+}
+function bestLocal(post, list, from, to) {
+    let best = -Infinity;
+    for (const ids of list) {
+        const v = forcedLocal(post, ids, from, to);
+        if (v > best)
+            best = v;
+    }
+    return best;
