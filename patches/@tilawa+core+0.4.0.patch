+    const next = corpus.wordPhonemes(L + 1);
+    const nextForms = [next, shortMadd(next)].filter((x, i, a) => a.indexOf(x) === i);
+    const cut = (head) => {
+        const out = [];
+        for (const tail of nextForms) {
+            const h = encodePhonemes(head);
+            const joined = encodePhonemes(head + tail);
+            const t = encodePhonemes(tail);
+            if (h && t)
+                out.push([...h, ...t.slice(0, anchor)]);
+            if (h && joined)
+                out.push(joined.slice(0, h.length + anchor));
+        }
+        return out;
+    };
