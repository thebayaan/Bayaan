+    const without = [];
+    for (const b of before) {
+        without.push(...cut(b));
+        for (const l of forms)
+            withLast.push(...cut(b + l));
+    }
+    return { withLast: distinct(withLast), without: distinct(without), nL: encodePhonemes(expected)?.length ?? 1 };
+}
