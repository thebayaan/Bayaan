+import type { QuranCorpus } from "./corpus.js";
+import type { FramePosteriors } from "./posteriors.js";
+import type { WordVerdict } from "./types.js";
+import type { VerdictTracer } from "./verdicts.js";
+/** Tuned on this model's output: they come from the caller's NPL-1.2 constants file. */
+export interface JunctionOptions {
+    /** Per token of the last word: h1 - h0 under this says the word was left out. */
+    llrMissing: number;
+    /** Early path: h0 must fit at least this well (nats against the free decode). */
+    fitNext: number;
+    /** Late path: h0 must fit at least this well. */
+    fitLate: number;
+    /** Frames searched before the word before. */
+    lookBackFrames: number;
+    /** How many of the next word's tokens the hypotheses must reach. */
+    anchorTokens: number;
+    /** Frames after the cursor enters the next ayah before the late decision. */
+    waitFrames: number;
+    /** How far back the word before may be, in words. */
+    lookBackWords: number;
+}
+export declare class JunctionCheck {
+    private readonly corpus;
+    private readonly opts;
+    private tracker;
+    private done;
+    private crossed;
+    private tokens;
+    constructor(corpus: QuranCorpus, opts: JunctionOptions);
+    apply(tracer: VerdictTracer, post: FramePosteriors, framesDecoded: number, verdicts: WordVerdict[]): WordVerdict[];
+    private settle;
+    private test;
+}
