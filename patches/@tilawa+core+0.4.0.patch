+// Bayaan patch. The stream's recent log-mel frames, so a second model can read them
+// instead of running its own FFT on the JS thread.
+import { FBANK_BINS } from "./config.js";
+/** About 10 s: 100 frames a second. */
+const HELD = 1000;
+/** Ring of log-mel frames, indexed by frame of the stream since the last reset. */
+export class MelFrames {
+    data = new Float32Array(FBANK_BINS * HELD);
+    start = 0;
+    end = 0;
+    push(frame) {
+        this.data.set(frame, (this.end % HELD) * FBANK_BINS);
+        this.end++;
+        if (this.end - this.start > HELD)
+            this.start = this.end - HELD;
+    }
+    clear() {
+        this.start = 0;
+        this.end = 0;
+    }
+    /** The features started again and their next frame is this one of the stream. The
+     * frame or two that spanned the restart repeat the last one, so that frames before
+     * and after it stay on one clock. */
+    moveTo(frame) {
+        if (this.end === this.start) {
+            this.start = frame;
+            this.end = frame;
+            return;
+        }
+        const slot = (this.end - 1) % HELD;
+        const last = this.data.slice(slot * FBANK_BINS, (slot + 1) * FBANK_BINS);
+        while (this.end < frame)
+            this.push(last);
+    }
+    /** A copy of frames [from, to) row by row, clipped to what is still held. */
+    read(from, to) {
+        const first = Math.max(from, this.start);
+        const frames = Math.max(0, Math.min(to, this.end) - first);
+        const data = new Float32Array(frames * FBANK_BINS);
+        const slot = first % HELD;
+        const untilWrap = Math.min(frames, HELD - slot);
+        data.set(this.data.subarray(slot * FBANK_BINS, (slot + untilWrap) * FBANK_BINS));
+        if (frames > untilWrap) {
+            data.set(this.data.subarray(0, (frames - untilWrap) * FBANK_BINS), untilWrap * FBANK_BINS);
+        }
+        return { first, frames, data };
+    }
+}
