 #import <ReactCommon/RCTTurboModule.h>
 #import <jsi/jsi.h>
 
+// React Native 0.88 removed RCTCxxBridge. The bridgeless RCTBridgeProxy (and
+// the old bridge) still implement -runtime, so call it by selector. The proxy
+// is an NSProxy, so check its class rather than -respondsToSelector:.
+@protocol OrtJSIRuntimeProvider <NSObject>
+- (void*)runtime;
+@end
+
 @implementation OnnxruntimeModule
 
