+    if (bridge == nil ||
+        !class_respondsToSelector(object_getClass(bridge), @selector(runtime))) {
       return @false;
     }
 
-    auto jsiRuntime = (facebook::jsi::Runtime*)cxxBridge.runtime;
+    auto jsiRuntime =
+        (facebook::jsi::Runtime*)[(id<OrtJSIRuntimeProvider>)bridge runtime];
     if (jsiRuntime == nil) {
       return @false;
     }
