{
  "name": "tv-smoke",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean",
    "tvos": "EXPO_TV=1 expo run:ios --device \"Apple TV 4K (3rd generation)\""
  },
  "dependencies": {
    "@shopify/flash-list": "^2.3.1",
    "expo": "~55.0.31",
    "expo-audio": "~55.0.18",
    "expo-font": "~55.0.6",
    "expo-image": "~55.0.11",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-native": "npm:react-native-tvos@0.83.10-1",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.4",
    "react-native-svg": "^15.15.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.7",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.10",
    "jest": "^30.3.0",
    "jest-expo": "~55.0.22",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native",
        "@shopify/flash-list",
        "react-native-svg",
        "jest",
        "@types/jest"
      ]
    }
  }
}
