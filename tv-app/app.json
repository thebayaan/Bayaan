{
  "expo": {
    "name": "Bayaan",
    "slug": "tv-smoke",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.bayaan.tvsmoke"
    },
    "android": {
      "package": "com.bayaan.tvsmoke"
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "tvosDeploymentTarget": "17.0",
          "removeFlipperOnAndroid": true,
          "androidTVBanner": "./assets/tv/android-tv-banner.png"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-image",
      "./plugins/withAppMediaKeys",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Manrope-Regular",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Manrope-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Manrope-Medium",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Manrope-Medium.ttf",
                    "weight": 500
                  }
                ]
              },
              {
                "fontFamily": "Manrope-SemiBold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Manrope-SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "Manrope-Bold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Manrope-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Manrope-ExtraBold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Manrope-ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "Manrope-Light",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Manrope-Light.ttf",
                    "weight": 300
                  }
                ]
              },
              {
                "fontFamily": "Manrope-ExtraLight",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Manrope-ExtraLight.ttf",
                    "weight": 200
                  }
                ]
              }
            ]
          }
        }
      ]
    ]
  }
}
