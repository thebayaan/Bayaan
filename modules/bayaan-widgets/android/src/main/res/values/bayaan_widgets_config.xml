<?xml version="1.0" encoding="utf-8"?>
<!--
  Fork seams (RFC-021). These are defaults only: plugins/withBayaanWidgets.js
  writes android/app/src/main/res/values/bayaan_widgets.xml from app.config.js,
  config/branding.js `widgets` and config/featureFlags.ts,
  and app resources override library resources with the same name.
-->
<resources>
  <string name="bayaan_widgets_url_scheme" translatable="false">bayaan</string>
  <!-- Widgets in the picker (receivers and their config activities). -->
  <bool name="bayaan_widget_enabled_continue_listening">true</bool>
  <bool name="bayaan_widget_enabled_continue_reading">true</bool>
  <bool name="bayaan_widget_enabled_quick_surah">true</bool>
  <bool name="bayaan_widget_enabled_pinned_reciter">true</bool>
  <bool name="bayaan_widget_enabled_ayah_of_the_day">true</bool>
  <bool name="bayaan_widget_enabled_tasbeeh">true</bool>
  <bool name="bayaan_widget_enabled_recently_played">true</bool>
  <bool name="bayaan_widget_enabled_library_shelf">true</bool>
  <bool name="bayaan_widget_enabled_bedtime">true</bool>
  <bool name="bayaan_widget_enabled_reciter_spotlight">true</bool>
  <bool name="bayaan_widget_enabled_adhkar">true</bool>
  <bool name="bayaan_widget_enabled_hijri_date">true</bool>
  <bool name="bayaan_widget_enabled_occasion">true</bool>
  <bool name="bayaan_widget_enabled_bayaan_now">true</bool>
  <!-- Flag-driven parts of widgets that otherwise stay. -->
  <bool name="bayaan_widgets_feature_adhkar">true</bool>
  <bool name="bayaan_widgets_feature_sleep_timer">true</bool>
  <bool name="bayaan_widgets_feature_ambient">true</bool>
</resources>
