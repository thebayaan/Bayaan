{
  "__doc": "Clusters (base + mark sequence, hex code points) of the rewayah words DBs that never occur in the DK Hafs DB, or that the DK fonts draw with a mark left without an anchor / turned into a spacing glyph. Each was rendered with HarfBuzz in DigitalKhattFont next to the official KFGQPC riwayah font and reviewed; 'allow' lists, per issue, the base before the cluster ('^' = start of the word) where the issue was reviewed. Checked by validate_rewayah_db.py --glyphs; see scripts/rewayah/README.md.",
  "families": {
    "nafi-sukun-circle": {"verdict": "ok", "note": "Nafi' sukun (KFGQPC U+0652, policy nafi-sukun) drawn as DK's small circle above the letter, as the KFGQPC Warsh / Qalun fonts draw it."},
    "wasl-alef": {"verdict": "limitation", "note": "Far-rewayah hamzat al-wasl and Warsh's naql alef: KFGQPC draws the connecting vowel as a stroke beside the alef, DK as a Madani vowel (it can look like a hamzat qat' without its hamza); the start dot above (U+06EC) is drawn as KFGQPC draws it; the dot below (U+065C) is drawn where DK draws the kasra, so a kasra on the same alef is hidden under it (see dot-overlaps-vowel)."},
    "start-dot-damma": {"verdict": "limitation", "note": "The start-with-damma dot beside a silent alef (policy start-dot-damma) is drawn as DK's small circle above the alef."},
    "tanween-on-alef": {"verdict": "ok", "note": "Maghribi placement of the tanween on the final alef / alef maksura; the letter before it carries no vowel (or only a shadda / a vowelless hamza). Drawn like the KFGQPC fonts."},
    "imala-dot": {"verdict": "ok", "note": "Imala / taqlil dot below the letter with DK's U+065C (Hafs 11:41), also with a shadda, dagger alef or waqf sign; taqlil and imala look alike (policy taqlil-open-dot)."},
    "tashil-dot": {"verdict": "ok", "note": "Tashil / ibdal / ikhtilas dot U+06EC with an anchor, drawn above the letter as in Hafs 41:44 (policy tashil-dot and the KFGQPC U+06EC); Bazzi / Qunbul 6:19 tooth with the dot below drawn like the KFGQPC font."},
    "dot-on-the-line": {"verdict": "limitation", "note": "U+06EC without an anchor in DK: after a joined alef, an alef madda or on waw / ya / dal / seen / ain / ha it is drawn on the line at the foot of the letter, where the KFGQPC fonts draw their dot for U+06DF (for their own U+06EC they draw it above). It never sits above a dal or ain, so it cannot be read as dhal or ghain."},
    "dot-overlaps-vowel": {"verdict": "limitation", "note": "Warsh 23:44: the tashil dot and the damma of the same alef are drawn on top of each other. The dot below (U+065C) and a kasra on the same letter are drawn in one place, so the kasra does not show (either order): words Warsh 270, Qalun 273, al-Duri 267, al-Susi 267 (mostly the wasl alef's start-with-kasra dot), al-Bazzi 23, Qunbul 23 (e.g. al-Bazzi 35:1 اِٜنَّ, Warsh 2:16 اِٜس۟تَو۟قَدَ); the KFGQPC fonts draw the dot beside the kasra."},
    "dagger-standing": {"verdict": "limitation", "note": "A dagger alef after an alef or carrying the tashil dot is drawn as a small standing alef with the dot on it ('أَرَٰ۬يْتَ', 'ءَاٰ۬مَنتُمْ', Qalun / Duri / Susi 'أَٰ۬ذَا') or, after a bare alef (Warsh naql 'اٰمَنَ'), as a second small alef; KFGQPC draws the dot above the small alef or a madd stroke."},
    "dagger-alef": {"verdict": "ok", "note": "Dagger alef combinations the Hafs text does not have (on ya, with madda or waqf signs, after a tatweel); after a non-joining letter or at the word end DK draws it standing, as the KFGQPC fonts do."},
    "muqattaat": {"verdict": "ok", "note": "Opening letters written with vowels / madda by the KFGQPC riwayah texts."},
    "hamza-seat": {"verdict": "ok", "note": "Hamza on a ya / waw / alef maksura / dagger seat with the vowel order or tanween of the KFGQPC riwayah texts."},
    "tatweel-hamza-below": {"verdict": "limitation", "note": "Hamza below a tatweel seat (Nafi' 'خَٰسِـِٕينَ', 'ٱلنَّبِيٓـِٕۧنَ'): no anchor, drawn on the tatweel line as a small hamza between the letters."},
    "unanchored-above": {"verdict": "limitation", "note": "No anchor, but the default position is above the letter as intended: Qunbul's small seen on 'صِۜرَٰطَ', the small noon on a tatweel in 12:110."},
    "waqf-combination": {"verdict": "ok", "note": "A waqf sign on a vowelless final letter (al-Susi's idgham kabir), on a ta marbuta, or after a vowel / tanween / sukun combination the Hafs text does not have."},
    "silah-small-letter": {"verdict": "ok", "note": "Small waw / ya with a waqf sign, sukun or a vowel (Duri 77:11 'اۥُقِّتَتْ' draws the small waw on the line, KFGQPC above the alef)."},
    "vowel-combination": {"verdict": "ok", "note": "Other vowel / tanween / madda combinations or letters the Hafs text does not have (alef madda U+0622, a lone tatweel, final ya with madda from the Maghribi ya); drawn like the KFGQPC fonts."}
  },
